        <div class="choice"><span class="cnum">②</span> responsibility</div>
        <div class="choice"><span class="cnum">③</span> exchange</div>
        <div class="choice"><span class="cnum">④</span> preservation</div>
        <div class="choice"><span class="cnum">⑤</span> profitability</div>
